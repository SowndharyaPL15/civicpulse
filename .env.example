# CivicPulse Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=otp_verification

# Email Service Configuration (Choose ONE option below)
# Option 1 (RECOMMENDED): Resend API (HTTPS Port 443 — 100% reliable, never blocked by cloud hosts or ISPs)
# Get a free key (3,000 emails/mo) at https://resend.com
RESEND_API_KEY=
MAIL_FROM=CivicPulse <onboarding@resend.dev>

# Option 2: Brevo API (HTTPS Port 443 — 300 emails/day free)
# Get a free key at https://brevo.com
BREVO_API_KEY=

# Option 3: Gmail / Custom SMTP (Note: Outbound SMTP port 587/465 is often blocked by ISPs and cloud hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=CivicPulse
SMTP_SECURE=tls

# Python Script Path (for AI complaint grouping)
# Leave empty to use default relative path
PYTHON_SCRIPT_PATH=
